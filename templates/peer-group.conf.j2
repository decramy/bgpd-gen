# Peer-groep: {{ group_name }}
{%- set incns = namespace(done=[]) %}
{% for session in sessions %}
{%- if session.relationship == 'Bilateral Peering' and session.irr_as_set %}
{%- set macro_file = 'as' ~ session.peer_asn %}
{%- if macro_file not in incns.done %}
{%- set incns.done = incns.done + [macro_file] %}
include "/etc/bgpd/peers/{{ macro_file }}.conf"
{%- endif %}
{%- endif %}
{%- endfor %}

{% for session in sessions %}
neighbor {{ session.remote_ip }} {
{%- set fabric = session.peering_network.fabric if session.peering_network else session.peer_name %}
{%- set short_name = session.name.replace(' (v4)', '').replace(' (v6)', '') if session.peer_name == fabric else session.peer_name %}
{%- set rel_letter = {'Transit': 'T', 'Route Server': 'R', 'Bilateral Peering': 'P'}.get(session.relationship, '?') %}
{%- set af_digit = '6' if ':' in session.remote_ip else '4' %}
	descr "{{ af_digit }}{{ rel_letter }} - {{ fabric }} - {{ short_name }}"
	remote-as {{ session.peer_asn }}
{%- if not session.enabled %}
	down
{%- endif %}
{%- if session.password %}
	tcp md5sig password "{{ session.password }}"
{%- endif %}
{%- if session.ttl %}
# Multihop (peer.ttl = hopcount, niet GTSM/ttl-security - dat is een apart,
# strenger mechanisme dat medewerking van de peer vereist). peer.source geeft
# desgewenst het lokale bindadres (default is anders het OS-routetabel-adres
# richting de peer, wat niet per se het bedoelde adres is bij multihop).
	multihop {{ session.ttl }}
{%- if session.source_ip %}
	local-address {{ session.source_ip }}
{%- endif %}
{%- endif %}
{%- if session.bfd_profile %}
	# BFD-profiel '{{ session.bfd_profile.name }}': min-tx {{ session.bfd_profile.minimum_interval }}ms, min-rx {{ session.bfd_profile.minimum_rx_interval }}ms, multiplier {{ session.bfd_profile.multiplier }}
	bfd
{%- endif %}
{%- set no_cap = session.relationship in ('Transit', 'Route Server') %}
{%- if ':' in session.remote_ip and session.ipv6_max_prefixes and not no_cap %}
	max-prefix {{ session.ipv6_max_prefixes }} restart 15
{%- elif ':' not in session.remote_ip and session.ipv4_max_prefixes and not no_cap %}
	max-prefix {{ session.ipv4_max_prefixes }} restart 15
{%- endif %}
{%- if session.relationship == 'Route Server' %}
	# Route-servers relayen routes van andere IX-deelnemers ongewijzigd door:
	# het AS-pad begint met het AS van de daadwerkelijke aankondiger, niet met
	# het AS van de route-server zelf. Zonder dit weigert bgpd elke ontvangen
	# route ("bad path, ... enforce neighbor-as enabled") en valt de sessie
	# meteen terug naar Idle zodra de eerste update binnenkomt.
	enforce neighbor-as no
{%- endif %}
}
{%- if session.relationship == 'Bilateral Peering' and transit_networks %}
# Bekende transit-netwerken mogen niet als tussenliggende hop in het pad
# van een bilaterale sessie voorkomen (bgpfilterguide.nlnog.net,
# "Filtering Known Transit Networks":
# https://bgpfilterguide.nlnog.net/guides/no_transit_leaks/) - een
# bilaterale peer die zo'n AS als transit-hop meestuurt, lekt
# waarschijnlijk hun eigen upstream-pad naar ons (een route-leak), geen
# legitieme aankondiging van hun eigen ruimte. Bewust beperkt tot
# Bilateral Peering: transit-sessies (ColoClue) horen de volle tabel te
# geven inclusief deze ASNs als transit-hop, en route-server-sessies
# (Frys-IX) bleken in de praktijk ook legitiem multi-hop paden te dragen
# - sommige IX-deelnemers zijn zelf transitproviders die hun eigen
# klanten via de route-server doorgeven (bv. Hurricane Electric,
# empirisch gevonden bij de RTBH-sweep van deze IX). Lijst (uit NetBox,
# AsPath 'known-transit-networks') overgenomen van de guide (grote
# tier-1/tier-2-operators); handmatig gecontroleerd tegen onze eigen
# bilaterale peers (geen overlap) zoals de guide zelf aanraadt - bij een
# nieuwe bilaterale peer die zelf op deze lijst staat, moet dat opnieuw.
deny quick from {{ session.remote_ip }} transit-as { {{ transit_networks | join(', ') }} }
{%- endif %}
{%- if session.relationship == 'Route Server' and session.peering_network %}
{%- set rs_is_v6 = ':' in session.remote_ip %}
{%- set rs_family = 6 if rs_is_v6 else 4 %}
{%- set canary = canary_v6 if rs_is_v6 else canary_v4 %}
{%- if canary %}
# RTBH-survey-canary altijd ongefilterd naar deze RS versturen, vóór en los
# van de survey-gated selectie hieronder ('quick', dus deze regel wint altijd
# van de latere or-longer-regel voor dezelfde /32-/128). Zonder deze
# uitzondering zou de canary zelf al de <rs-asn>:0:0-communities van de
# vorige survey-run meekrijgen en dus alleen nog relayed worden naar reeds
# als OK bekende ASN's - een cirkelredenering waarbij nieuwe of eerder
# afgekeurde deelnemers nooit meer OK kunnen worden (rtbh_survey.py kan de
# testroute dan simpelweg nooit meer bij ze krijgen).
allow quick to {{ session.remote_ip }} prefix {{ canary }}/{{ '128' if rs_is_v6 else '32' }}
{%- endif %}
{%- set survey = rtbh_survey_by_fabric.get((session.peering_network.fabric, rs_family)) %}
{%- if survey is not none %}
# Eigen prefixes via deze route-server (IPv{{ rs_family }}) alleen naar
# deelnemers die RTBH aantoonbaar toepassen (rtbh_survey.py --family
# {{ rs_family }}, resultaat in rtbh-surveys/*-v{{ rs_family }}.txt -
# {{ survey | length }} OK-ASN(s) op dit moment - v4/v6 zijn bewust losse
# survey-resultaten, RTBH-gedrag over de ene family garandeert niets over
# de andere). IXP Manager-communityschema (het RS-AS is {{ session.peer_asn }}):
# <rs-asn>:0:0 weerhoudt de route van alle deelnemers via deze RS, een
# losse <rs-asn>:1:<asn> geeft daar per AS een uitzondering op boven op.
# Default-deny, niet default-allow-met-losse-uitsluitingen: bij de eerste
# FrysIX-survey waren er ruim vier keer zoveel FAIL als OK, dus een
# allow-lijst is de kortere configuratie. Geen survey ooit gedraaid voor
# deze fabric/family = deze regel wordt helemaal niet gegenereerd
# (fail-open, zie generate.py's _rtbh_survey_by_fabric), dus dit is puur
# opt-in per fabric+family.
{% for p in own_prefixes if (':' in p) == rs_is_v6 %}
allow to {{ session.remote_ip }} prefix {{ p }} or-longer set { large-community {{ session.peer_asn }}:0:0{% for asn in survey %} large-community {{ session.peer_asn }}:1:{{ asn }}{% endfor %} }
{%- endfor %}
{%- endif %}
{%- endif %}
{%- if session.relationship == 'Bilateral Peering' and session.irr_as_set %}
{%- set fam = 'v6' if ':' in session.remote_ip else 'v4' %}
# Directe peer: alleen routes toestaan die door de eigen IRR as-set ({{ session.irr_as_set }}) zijn gedekt.
# Geen 'prefix-set'-keyword: de macro-waarde is zelf al een 'prefix { ... }'-
# clausule (bgpq4-formaat), geen aparte prefix-set-naam.
allow from {{ session.remote_ip }} $prefix_set_as{{ session.peer_asn }}_{{ fam }}
{%- for af in session.address_families %}
{%- if af.prefix_list_in %}
# Handmatige aanvulling vanuit NetBox (bv. RFC1918-uitwisseling), additief bovenop de IRR-filter
allow from {{ session.remote_ip }} prefix-set "{{ af.prefix_list_in.name }}"
{%- endif %}
{%- endfor %}
{%- else %}
{%- for af in session.address_families %}
{%- if af.prefix_list_in %}
allow from {{ session.remote_ip }} prefix-set "{{ af.prefix_list_in.name }}"
{%- endif %}
{%- endfor %}
{%- endif %}
{%- for af in session.address_families %}
{%- if af.prefix_list_out %}
allow to {{ session.remote_ip }} prefix-set "{{ af.prefix_list_out.name }}"
{%- endif %}
{%- if af.route_map_in %}
# route-map-in '{{ af.route_map_in.name }}' - vertaal naar match/set-condities indien nodig
{%- endif %}
{%- if af.route_map_out %}
# route-map-out '{{ af.route_map_out.name }}' - vertaal naar match/set-condities indien nodig
{%- endif %}
{%- endfor %}
{%- if session.maintenance %}
# Onderhoudsmodus (NetBox-tag 'maintenance' op de sessie, het peer-ASN of de fabric/IX):
# sessie blijft Established (geen 'down'), maar deze twee regels overrulen als allerlaatste
# match élke eerder toegestane import/export voor deze neighbor hierboven - inclusief een
# eventuele IRR-macro-allow en de globale 'allow to any prefix <eigen-prefix>' verderop in
# bgpd.conf.
deny quick from {{ session.remote_ip }}
deny quick to {{ session.remote_ip }}
{%- endif %}
{% endfor %}
